{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nx-cache-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "workers_dev": true,
  "r2_buckets": [
    {
      "binding": "CACHE_BUCKET",
      "bucket_name": "nx-cache"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
